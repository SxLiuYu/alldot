{
  "id": "dot-core",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "vision": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "approvals": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inline_wait_ms": {
            "type": "number",
            "default": 90000
          },
          "ttl_hours": {
            "type": "number",
            "default": 24
          },
          "auto_approve_max_tier": {
            "type": "number",
            "default": 0
          }
        }
      },
      "desktop": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "batch_actions": {
            "type": "number",
            "default": 10
          },
          "exclude_processes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "human_only_apps": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "Weixin",
              "WeChat"
            ]
          },
          "mcp_url": {
            "type": "string",
            "default": "http://127.0.0.1:8000/mcp",
            "description": "Windows-MCP 的 streamable-HTTP 地址"
          }
        }
      },
      "browser": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "captcha": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [
                  "验证码",
                  "captcha",
                  "滑块",
                  "人机验证"
                ],
                "description": "snapshot/截图里命中就停手交还人手的验证码关键词"
              }
            }
          },
          "logged_mcp_url": {
            "type": "string",
            "default": "http://localhost:8931/mcp"
          },
          "clean_mcp_url": {
            "type": "string",
            "default": "http://localhost:8932/mcp"
          },
          "clean_profile": {
            "type": [
              "string",
              "null"
            ],
            "default": null,
            "description": "干净浏览器 profile；null=--isolated，不留任何状态"
          }
        }
      },
      "budget": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tokens": {
            "type": "number",
            "default": 2000000
          }
        }
      },
      "keepalive": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "probe_interval_min": {
            "type": "number",
            "default": 5
          },
          "probe_tiers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "cheap",
              "balanced",
              "strong"
            ]
          },
          "disk": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "warn_gb": {
                "type": "number",
                "default": 5
              },
              "red_gb": {
                "type": "number",
                "default": 2
              },
              "pause_gb": {
                "type": "number",
                "default": 0.8
              },
              "resume_gb": {
                "type": "number",
                "default": 1
              },
              "hysteresis_min": {
                "type": "number",
                "default": 10
              }
            }
          },
          "artifacts_max_gb": {
            "type": "number",
            "default": 2
          },
          "snapshots_max_gb": {
            "type": "number",
            "default": 5
          },
          "backups_max_gb": {
            "type": "number",
            "default": 5
          },
          "guard_log_max_mb": {
            "type": "number",
            "default": 50
          }
        }
      },
      "exec": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "whitelist": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      },
      "dispatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "interval_ms": {
            "type": "number",
            "default": 5000
          },
          "session_timeout_ms": {
            "type": "number",
            "default": 600000
          },
          "max_concurrent": {
            "type": "number",
            "default": 1
          },
          "lock_ttl_ms": {
            "type": "number",
            "default": 900000
          }
        }
      },
      "practice": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "root": {
            "type": [
              "string",
              "null"
            ],
            "default": null,
            "description": "练习文件夹绝对路径；null=没配，最小那只手拒绝执行"
          }
        }
      },
      "say": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false,
            "description": "说人话改写层开关；默认关，关着时桥的卡片逐字不动"
          }
        }
      },
      "notify": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false,
            "description": "把「要你批」和「任务结果」推到手机开关；默认关，配好 webhook 再开"
          },
          "feishu_webhook": {
            "type": "string",
            "default": "",
            "description": "飞书自定义机器人 webhook 地址；不填则走微信通道"
          },
          "poll_sec": {
            "type": "number",
            "default": 10,
            "description": "轮询账本的间隔秒数；只推审批与任务结果，不推进度"
          },
          "wechat_python": {
            "type": "string",
            "default": "",
            "description": "微信 helper 用的 python.exe；填了才启用微信通道"
          },
          "wechat_script": {
            "type": "string",
            "default": "",
            "description": "微信 helper 脚本路径（build/tools/wechat-notify.py）"
          },
          "wechat_marker": {
            "type": "string",
            "default": "alldot",
            "description": "发送前用来确认当前会话对不对的标记文字"
          }
        }
      },
      "self_improve": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "自我优化开关；默认开（2026-11-25 按用户要求改为默认开），关着时只允许体检，不许出提案、不许写补丁。开着也只写账本提案与请示卡，绝不改源码"
          },
          "max_proposals_per_day": {
            "type": "number",
            "default": 2,
            "description": "每天最多落几条提案（按 UTC 日期算）"
          }
        }
      },
      "wechat": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "微信那只手（wechat-mcp 的 HTTP 入口）默认开；服务没起时调了就是干不了"
          },
          "mcp_url": {
            "type": "string",
            "default": "http://127.0.0.1:8933/mcp",
            "description": "wechat-mcp 的 streamable-HTTP 地址（默认 http://127.0.0.1:8933/mcp）"
          }
        }
      },
      "mobile_access": {
        "type": "object",
        "additionalProperties": false,
        "description": "手机接入方式；默认 loopback（只本机，手机连不上）",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "loopback",
              "lan",
              "tunnel",
              "relay"
            ],
            "default": "loopback",
            "description": "loopback=只本机；lan=局域网直连；tunnel=内网穿透；relay=自定义中继"
          },
          "allowed_cidrs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "额外放行的来源 IP/CIDR（留空=按接入模式默认规则）"
          }
        }
      },
      "voice": {
        "type": "object",
        "additionalProperties": false,
        "description": "语音 ASR/TTS 上游；复用 nanoMuse 的 /v1/audio/* 接口，密钥走环境变量，不写进配置",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false,
            "description": "语音开关；默认关"
          },
          "base_url": {
            "type": "string",
            "default": "https://www.sxliuyu.bond",
            "description": "上游 base URL，不带 /v1"
          },
          "api_key_env": {
            "type": "string",
            "default": "ALLDOT_VOICE_API_KEY",
            "description": "上游 API key 的环境变量名"
          },
          "voice": {
            "type": "string",
            "default": "alloy",
            "description": "TTS 音色"
          },
          "max_asr_seconds": {
            "type": "number",
            "default": 58
          },
          "max_tts_chars": {
            "type": "number",
            "default": 450
          }
        }
      }
    }
  }
}
